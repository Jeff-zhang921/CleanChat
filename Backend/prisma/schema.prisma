// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                @id @default(autoincrement())
  email             String             @unique
  name              String
  cleanId           String             @unique
  avatar            Avatar             @default(AVATAR_LEO)
  gender            String             @default("hidden")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  AThread           ChatThread[]       @relation("AThreads")
  BThread           ChatThread[]       @relation("BThreads")
  message           ChatMessage[]
  pushSubscriptions PushSubscription[]
  blocksInitiated   ChatBlock[]        @relation("ChatBlockByUser")
  blockedBy         ChatBlock[]        @relation("ChatBlockedUser")
  chatRequestsSent  ChatRequest[]      @relation("ChatRequestsSent")
  chatRequestsInbox ChatRequest[]      @relation("ChatRequestsInbox")
}

model LoginCode {
  id        Int       @id @default(autoincrement())
  email     String
  codeHash  String
  expireAt  DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, expireAt])
}

model ChatThread {
  id            Int           @id @default(autoincrement())
  AID           Int
  BID           Int
  lastMessageAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  //AID equal to the id in user field
  UserA         User          @relation("AThreads", fields: [AID], references: [id])
  UserB         User          @relation("BThreads", fields: [BID], references: [id])
  Messages      ChatMessage[]
  acceptedBy    ChatRequest[] @relation("ChatRequestAcceptedThread")

  @@unique([AID, BID])
}

model ChatMessage {
  id              Int           @id @default(autoincrement())
  threadId        Int
  senderId        Int
  body            String
  parentMessageId Int?
  quoteSenderName String?
  quotePreview    String?
  createdAt       DateTime      @default(now())
  thread          ChatThread    @relation(fields: [threadId], references: [id])
  sender          User          @relation(fields: [senderId], references: [id])
  parentMessage   ChatMessage?  @relation("ChatMessageQuotes", fields: [parentMessageId], references: [id], onDelete: SetNull)
  quotedMessages  ChatMessage[] @relation("ChatMessageQuotes")

  @@index([parentMessageId])
}

model ChatBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blocker User @relation("ChatBlockByUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("ChatBlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model ChatRequest {
  id               Int               @id @default(autoincrement())
  requesterId      Int
  recipientId      Int
  note             String
  status           ChatRequestStatus @default(PENDING)
  acceptedThreadId Int?
  resolvedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  requester      User        @relation("ChatRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient      User        @relation("ChatRequestsInbox", fields: [recipientId], references: [id], onDelete: Cascade)
  acceptedThread ChatThread? @relation("ChatRequestAcceptedThread", fields: [acceptedThreadId], references: [id], onDelete: SetNull)

  @@index([recipientId, status, createdAt])
  @@index([requesterId, recipientId, status])
}

model PushSubscription {
  id             Int       @id @default(autoincrement())
  userId         Int
  endpoint       String    @unique
  p256dh         String
  auth           String
  expirationTime DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastSeenAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RuntimeState {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ChatRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum Avatar {
