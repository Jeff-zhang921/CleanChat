# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cleanchat?schema=public"

# Auth
JWT_SECRET="replace_with_strong_secret"
ACCESS_TOKEN_TTL="1y"
LOGIN_CODE_SECRET="replace_with_strong_secret"

# Email login
SMTP_USER="mailer@example.com"
SMTP_PASS="app_password"
SMTP_FROM="CleanChat <no-reply@example.com>"

# CORS / frontend origins
FRONTEND_URLS="http://127.0.0.1:5273,https://your-frontend-domain"

# Web Push (required for notifications)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="base64url_public_key"
VAPID_PRIVATE_KEY="base64url_private_key"
VAPID_SUBJECT="mailto:no-reply@example.com"

# Optional ops token for protected maintenance endpoints
OPS_TOKEN="change-this"
